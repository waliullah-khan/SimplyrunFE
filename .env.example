# N8N Webhook Configuration
# Copy this file to .env and update with your values
WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-webhook-id/chat

# GHL API Configuration
# Location ID for your GHL account
LOCATION_ID=your_location_id

# API Token for GHL API access
# WARNING: Never commit this token to version control
# For production, use Vercel environment variables or a backend proxy
API_TOKEN=your_api_token


# ElevenLabs API Configuration
# For audio usage tracking
XI_API_KEY=your_elevenlabs_api_key

# HeyGen API Configuration
# For video usage tracking
X_API_KEY=your_heygen_api_key

# =============================================================================
# Social Media Platform Accounts (for posting)
# =============================================================================
# Format: PLATFORM_ACCOUNT_ID=<account_id>
# Leave empty or remove if platform is not used
# Only configured platforms will be fetched for social media posts

FACEBOOK_ACCOUNT_ID=
INSTAGRAM_ACCOUNT_ID=
THREADS_ACCOUNT_ID=
GBP_ACCOUNT_ID=
LINKEDIN_ACCOUNT_ID=
TIKTOK_ACCOUNT_ID=
YOUTUBE_ACCOUNT_ID=
PINTEREST_ACCOUNT_ID=
COMMUNITY_ACCOUNT_ID=
BLUESKY_ACCOUNT_ID=

# =============================================================================
# Analytics Profile IDs (for analytics/statistics)
# =============================================================================
# Format: PLATFORM_ANALYTICS_ID=<profile_id>
# Leave empty or remove if platform analytics is not used
# Only configured platforms will be fetched for analytics

FACEBOOK_ANALYTICS_ID=
INSTAGRAM_ANALYTICS_ID=
THREADS_ANALYTICS_ID=
GBP_ANALYTICS_ID=
LINKEDIN_ANALYTICS_ID=
TIKTOK_ANALYTICS_ID=
YOUTUBE_ANALYTICS_ID=
PINTEREST_ANALYTICS_ID=
COMMUNITY_ANALYTICS_ID=
BLUESKY_ANALYTICS_ID=
